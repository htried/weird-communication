# Password gate (HTTP basic auth). The deploy workflow replaces __HTPASSWD__ with the absolute
# path of the password file, which it uploads to the web root as .htpasswd (from
# deploy/theagentsaretalking.htpasswd in the repo); .ht* files are denied below.
AuthType Basic
AuthName "The Agents Are Talking"
AuthUserFile __HTPASSWD__
Require valid-user

# Link previews and icons: the password prompt's page carries only the preview title and image,
# and the preview image and favicons are public. Nothing else is reachable without the password.
ErrorDocument 401 /401.html
<FilesMatch "^(401\.html|og\.png|favicon\.ico|favicon-32\.png|favicon-192\.png|apple-touch-icon\.png)$">
  # LiteSpeed honors the 2.2-style Satisfy/Allow form here; Require all granted is for Apache 2.4.
  Satisfy Any
  Order allow,deny
  Allow from all
  Require all granted
</FilesMatch>

# Keep it out of search engines and shared caches (the Hostinger CDN must not serve
# authenticated pages to anyone else).
<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow, noarchive"
  Header always set Cache-Control "private, no-store"
</IfModule>

Options -Indexes

# Don't serve housekeeping files
<FilesMatch "^(\.ht.*|README\.md)$">
  Require all denied
</FilesMatch>
